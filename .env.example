# ==============================================================================
# Automated News Topic Monitoring Using Agentic AI - Environment Configuration
# ==============================================================================

# Groq API Configuration
# Get your free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Tavily Search API Configuration
# Get your free key at: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Database Configuration
# Local development: SQLite
# Production (e.g. Neon on Vercel): postgresql://user:password@ep-sample.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///news_monitor.db

# Vercel Cron Authentication Secret
# Protects /api/cron/monitor from unauthorized triggering
CRON_SECRET=super_secret_cron_token_change_me_in_production

# Demo & Evaluation Mode
# Set to 'true' to run fully offline with simulated news feeds & Groq AI analysis
# If GROQ_API_KEY or TAVILY_API_KEY are missing, DEMO_MODE automatically engages.
DEMO_MODE=false

# Optional Flask Server Port (Default: 5000)
PORT=5000
FLASK_DEBUG=false
